#!/usr/bin/env bash
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
	echo "registry installer must run as root" >&2
	exit 1
fi

stage="${1:?usage: install <deployment bundle> <git commit>}"
source_commit="${2:?usage: install <deployment bundle> <git commit>}"
registry_user=pacvamp-registry
registry_root=/srv/pacvamp
state_root=/var/lib/pacvamp-registry
config_root=/etc/pacvamp-registry
canary_root=/usr/local/lib/pacvamp-registry/canary
package_root=/usr/local/lib/pacvamp-registry/pacvamp

for file in \
	"$stage/bin/packslip" \
	"$stage/bin/pacvamp-repo" \
	"$stage/deploy/registry/pacvamp/pacvamp" \
	"$stage/deploy/registry/pacvamp/PKGBUILD" \
	"$stage/deploy/registry/pacvamp/LICENSE" \
	"$stage/deploy/registry/pacvamp/pacvamp-registry.pub" \
	"$stage/deploy/registry/Caddyfile"; do
	test -f "$file"
done

pacman -Syu --needed --noconfirm base-devel caddy git gnupg

install -Dm755 "$stage/bin/packslip" /usr/local/bin/packslip
install -Dm755 "$stage/bin/pacvamp-repo" /usr/local/bin/pacvamp-repo
install -Dm644 "$stage/deploy/registry/pacvamp-registry.sysusers" \
	/usr/lib/sysusers.d/pacvamp-registry.conf
systemd-sysusers /usr/lib/sysusers.d/pacvamp-registry.conf
install -Dm644 "$stage/deploy/registry/pacvamp-registry.tmpfiles" \
	/usr/lib/tmpfiles.d/pacvamp-registry.conf
systemd-tmpfiles --create /usr/lib/tmpfiles.d/pacvamp-registry.conf

install -Dm755 "$stage/deploy/registry/bin/publish" \
	/usr/local/lib/pacvamp-registry/publish
install -Dm755 "$stage/deploy/registry/bin/snapshot" \
	/usr/local/lib/pacvamp-registry/snapshot
install -d "$canary_root"
install -m 0644 "$stage/deploy/registry/canary/PKGBUILD" \
	"$canary_root/PKGBUILD"
test -f "$canary_root/PKGBUILD"
install -d "$package_root"
install -m 0755 "$stage/deploy/registry/pacvamp/pacvamp" \
	"$package_root/pacvamp"
install -m 0644 \
	"$stage/deploy/registry/pacvamp/PKGBUILD" \
	"$stage/deploy/registry/pacvamp/LICENSE" \
	"$stage/deploy/registry/pacvamp/pacvamp-registry.pub" \
	"$package_root/"
test -x "$package_root/pacvamp"
for unit in \
	pacvamp-registry-publish.service \
	pacvamp-registry-snapshot.service \
	pacvamp-registry-snapshot.timer; do
	install -Dm644 "$stage/deploy/registry/$unit" "/etc/systemd/system/$unit"
done

if [[ ! -f $config_root/index.key ]]; then
	runuser -u "$registry_user" -- packslip keygen -o "$config_root/index.key"
fi
if [[ ! -f $config_root/build.key ]]; then
	runuser -u "$registry_user" -- packslip keygen -o "$config_root/build.key"
fi
if ! runuser -u "$registry_user" -- env GNUPGHOME="$state_root/gnupg" \
	gpg --batch --list-secret-keys registry@pacvamp.com >/dev/null 2>&1; then
	runuser -u "$registry_user" -- env GNUPGHOME="$state_root/gnupg" \
		gpg --batch --passphrase '' --quick-generate-key \
		'Pacvamp Registry <registry@pacvamp.com>' ed25519 sign 2y
fi
gpg_fingerprint="$(runuser -u "$registry_user" -- env GNUPGHOME="$state_root/gnupg" \
	gpg --batch --with-colons --list-secret-keys registry@pacvamp.com |
	awk -F: '$1 == "fpr" { print $10; exit }')"
test -n "$gpg_fingerprint"

config="$(mktemp "$config_root/.registry.env.XXXXXX")"
{
	printf 'PACVAMP_REGISTRY_ROOT=%s\n' "$registry_root"
	printf 'PACVAMP_INDEX_KEY=%s\n' "$config_root/index.key"
	printf 'PACVAMP_BUILD_KEY=%s\n' "$config_root/build.key"
	printf 'PACVAMP_BUILD_PUB=%s\n' "$config_root/build.pub"
	printf 'PACVAMP_GPG_KEY=%s\n' "$gpg_fingerprint"
	printf 'PACVAMP_SOURCE_URL=%s\n' 'https://github.com/jdx/pacvamp'
	printf 'PACVAMP_SOURCE_COMMIT=%s\n' "$source_commit"
	printf 'PACVAMP_CANARY_DIR=%s\n' "$canary_root"
	printf 'PACVAMP_PACKAGE_DIR=%s\n' "$package_root"
	printf 'GNUPGHOME=%s\n' "$state_root/gnupg"
} >"$config"
chown "$registry_user:$registry_user" "$config"
chmod 0640 "$config"
mv "$config" "$config_root/registry.env"

install -o "$registry_user" -g "$registry_user" -m 0644 \
	"$config_root/index.pub" "$registry_root/store/keys/index.pub"
repository_key="$(mktemp "$registry_root/store/keys/.repository.asc.XXXXXX")"
runuser -u "$registry_user" -- env GNUPGHOME="$state_root/gnupg" \
	gpg --armor --export registry@pacvamp.com >"$repository_key"
chown "$registry_user:$registry_user" "$repository_key"
chmod 0644 "$repository_key"
mv "$repository_key" "$registry_root/store/keys/repository.asc"

caddy validate --config "$stage/deploy/registry/Caddyfile"
install -Dm644 "$stage/deploy/registry/Caddyfile" /etc/caddy/Caddyfile
systemctl daemon-reload
systemctl enable --now caddy

systemctl start pacvamp-registry-publish.service
systemctl start pacvamp-registry-snapshot.service
id="$(basename "$(readlink "$registry_root/store/channels/rc")")"
runuser -u "$registry_user" -- pacvamp-repo snapshot \
	--store "$registry_root/store" \
	--key "$config_root/index.key" \
	promote --channel stable --id "$id"

systemctl enable --now pacvamp-registry-snapshot.timer
systemctl reload caddy
systemctl is-active --quiet caddy
test -L "$registry_root/store/channels/stable"

echo "deployed Pacvamp registry commit $source_commit"
