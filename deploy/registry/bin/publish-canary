#!/usr/bin/env bash
set -euo pipefail

config="${PACVAMP_REGISTRY_CONFIG:-/etc/pacvamp-registry/registry.env}"
if [[ -r $config ]]; then
	set -a
	# shellcheck source=/dev/null
	source "$config"
	set +a
fi

: "${PACVAMP_REGISTRY_ROOT:?set PACVAMP_REGISTRY_ROOT}"
: "${PACVAMP_INDEX_KEY:?set PACVAMP_INDEX_KEY}"
: "${PACVAMP_BUILD_KEY:?set PACVAMP_BUILD_KEY}"
: "${PACVAMP_BUILD_PUB:?set PACVAMP_BUILD_PUB}"
: "${PACVAMP_GPG_KEY:?set PACVAMP_GPG_KEY}"
: "${PACVAMP_SOURCE_URL:?set PACVAMP_SOURCE_URL}"
: "${PACVAMP_SOURCE_COMMIT:?set PACVAMP_SOURCE_COMMIT}"

if [[ $PACVAMP_GPG_KEY == replace-* || $PACVAMP_SOURCE_COMMIT == replace-* ]]; then
	echo "replace the placeholder values in registry.env before publishing" >&2
	exit 1
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
canary_dir="${PACVAMP_CANARY_DIR:-$script_dir/../canary}"
repo_dir="$PACVAMP_REGISTRY_ROOT/sync/pacvamp/os/x86_64"
build_dir="$(mktemp -d "${TMPDIR:-/tmp}/pacvamp-canary.XXXXXX")"
lock="$PACVAMP_REGISTRY_ROOT/.publish.lock"

cleanup() {
	rm -rf "$build_dir"
}
trap cleanup EXIT

install -d "$PACVAMP_REGISTRY_ROOT"
exec 9>"$lock"
flock --nonblock 9 || {
	echo "another registry publish is running" >&2
	exit 1
}

install -d "$repo_dir"
cp "$canary_dir/PKGBUILD" "$build_dir/PKGBUILD"

(
	cd "$build_dir"
	makepkg --clean --cleanbuild --force --noconfirm
)

mapfile -t packages < <(find "$build_dir" -maxdepth 1 -type f -name '*.pkg.tar.zst' -print)
if [[ ${#packages[@]} -ne 1 ]]; then
	echo "expected one canary package, found ${#packages[@]}" >&2
	exit 1
fi

package="${packages[0]}"
filename="$(basename "$package")"
published="$repo_dir/$filename"
if [[ -e $published ]]; then
	echo "$published already exists; bump pkgrel before publishing again" >&2
	exit 1
fi
install -m 0644 "$package" "$published"

pacvamp-repo attest \
	--key "$PACVAMP_BUILD_KEY" \
	--pkgbase pacvamp-registry-canary \
	--source "$PACVAMP_SOURCE_URL" \
	--commit "$PACVAMP_SOURCE_COMMIT" \
	"$published"

pacvamp-repo sign \
	--dir "$repo_dir" \
	--package "$filename" \
	--build-key "$PACVAMP_BUILD_PUB" \
	--gpg-key "$PACVAMP_GPG_KEY"

repo-add \
	--remove \
	--include-sigs \
	--sign \
	--key "$PACVAMP_GPG_KEY" \
	"$repo_dir/pacvamp.db.tar.zst" \
	"$published"

pacvamp-repo index \
	--repo pacvamp \
	--dir "$repo_dir" \
	--key "$PACVAMP_INDEX_KEY" \
	--build-key "$PACVAMP_BUILD_PUB"

echo "published $filename to the mutable repository; cut a snapshot next"
