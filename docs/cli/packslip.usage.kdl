name packslip
bin packslip
version "0.1.0"
author "Jeff Dickey <@jdx>"
about "Create and verify packslip release manifests"
long_about #"""
Create and verify packslip release manifests

A packslip is one signed document per release that says what the artifacts are and how to verify them, so any consumer can pin one identity and check downloads without per-vendor logic.
"""#
arg_required_else_help #true
flag "-h --help" help="Print help" action=help builtin=#true
flag "-V --version" help="Print version" action=version builtin=#true
cmd create help="Create and sign a packslip for a release" {
    long_help #"""
Create and sign a packslip for a release

Digests every artifact, infers os/arch/libc/format from file names (override with name:os/arch), and writes packslip.json plus packslip.json.minisig into --out.
"""#
    flag --project help="Package URL of the project, such as pkg:github/jdx/mise" required=#true {
        arg <PROJECT>
    }
    flag --version help="The release version" required=#true {
        arg <VERSION>
    }
    flag "-k --key" help="Secret key file from `packslip keygen`" required=#true {
        arg <KEY>
    }
    flag "-o --out" help="Directory to write into" default=. {
        arg <OUT>
    }
    flag --url-base help="Download URL prefix for the artifacts" {
        arg <URL_BASE>
    }
    flag --source-repo help="Source repository URL" {
        arg <SOURCE_REPO>
    }
    flag --commit help="Source commit" {
        arg <COMMIT>
    }
    flag --tag help="Source tag" {
        arg <TAG>
    }
    flag --published-at help="RFC 3339 publish time; defaults to now" {
        arg <PUBLISHED_AT>
    }
    flag --sbom help="SBOM URL" {
        arg <SBOM>
    }
    flag --supersedes help="The version this release replaces" {
        arg <SUPERSEDES>
    }
    flag --provenance help="Provenance URL for every artifact (repeatable, positional order)" var=#true {
        arg <PROVENANCE>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <ARTIFACTS>... help="Artifact files, optionally as path:os/arch[/libc]"
    complete key type=path
}
cmd keygen help="Generate a signing key pair" {
    long_help #"""
Generate a signing key pair

Writes the secret seed to the given path (mode 0600) and a minisign-format public key beside it with a .pub extension.
"""#
    flag "-o --out" help="Where to write the secret key" default=packslip.key {
        arg <OUT>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd schema help="Print the JSON schema of the document" {
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd verify help="Verify a packslip against a pinned public key" {
    long_help #"""
Verify a packslip against a pinned public key

Checks the signature, the document, and the digest and size of every artifact file given. Exits 1 on any failure.
"""#
    flag "-p --pubkey" help="The minisign public key file, or its base64 line" required=#true {
        arg <PUBKEY>
    }
    flag "-s --signature" help="The signature file; defaults to <document>.minisig" {
        arg <SIGNATURE>
    }
    flag "-a --artifact" help="Artifact files to check against the document" var=#true {
        arg <ARTIFACT>
    }
    flag "-J --json" help="Print the result as JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <DOCUMENT> help="The packslip.json to verify"
    complete document type=path
}
cmd version help="Show the version" {
    alias v
    flag "-J --json" help="Print as JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
}
