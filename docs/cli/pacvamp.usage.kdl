name pacvamp
bin pacvamp
version "0.1.0"
author "Jeff Dickey <@jdx>"
about "A trust-focused package manager for pacman-based Linux distributions"
long_about "pacvamp installs, removes, and updates packages from the Arch mirror, the Omarchy Package Repository, and the AUR through one command, with trust tiers, commit-bound AUR builds, and policy that is stricter when nobody is watching. https://github.com/jdx/pacvamp"
arg_required_else_help #true
flag --config help="Read this pacman.conf instead of /etc/pacman.conf" global=#true {
    arg <CONFIG>
}
flag --sysroot help="Operate on an alternative root, like pacman --sysroot" global=#true {
    arg <SYSROOT>
}
flag "-h --help" help="Print help" action=help builtin=#true
flag "-V --version" help="Print version" action=version builtin=#true
complete config type=path
complete sysroot type=dir
cmd add help="Declare packages in your manifest, then install them" {
    long_help #"""
Declare packages in your manifest, then install them

Writes to the user manifest and converges only the packages named, so other declarations are left for `apply`.
"""#
    flag --absent help="Declare the packages absent, and remove them if installed"
    flag --aur help="Declare the packages as coming from the AUR"
    flag --hold help="Never upgrade the packages"
    flag "-y --yes" help="Proceed without asking; refuses a plan with warnings"
    flag "-n --dry-run" help="Update the manifest and show what would run, run nothing"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <PACKAGES>... help="Package names, optionally as repo/name"
}
cmd apply help="Make the machine match the manifest" {
    long_help #"""
Make the machine match the manifest

Installs what is declared present and missing, then removes what is declared absent and installed. Each transaction is shown and confirmed like `install` and `remove`.
"""#
    flag "-y --yes" help="Proceed without asking; refuses a plan with warnings"
    flag "-n --dry-run" help="Show the plan and the commands, run nothing"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd audit help="List installed packages with open security issues" {
    long_help #"""
List installed packages with open security issues

Joins the local database against Arch's security tracker: a package is listed when a tracker group names it, the group is not "Not affected", and the installed version is below the fixed one (or no fix exists yet). Versions compare the way pacman compares them.
"""#
    flag "-u --upgradable" help="Only issues an upgrade would fix"
    flag --offline help="Use the cached tracker only"
    flag --fail help="Exit 1 when any issue is listed"
    flag "-J --json" help="Print as JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd aur help="Review, approve, and build AUR packages" subcommand_required=#true {
    flag "-h --help" help="Print help" action=help builtin=#true
    cmd approve help="Approve an AUR package's commit for building" {
        long_help #"""
Approve an AUR package's commit for building

Records the reviewed commit and the evidence in pacvamp.lock next to the user manifest. Interactively, the findings are shown and you confirm; unattended, a denied review is refused unless --force.
"""#
        flag --commit help="Approve this commit instead of the current one" {
            arg <COMMIT>
        }
        flag --force help="Approve without asking, even over denials"
        flag "-y --yes" help="Approve without asking when nothing denies"
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <PACKAGE> help="The package name"
    }
    cmd build help="Build an approved AUR package without installing it" {
        long_help #"""
Build an approved AUR package without installing it

Sources are fetched with network, then makepkg runs in the jail with writes limited to the build directory and no network unless the manifest grants it. Prints the package files it built.
"""#
        flag --commit help="Build this commit instead of the approved one" {
            arg <COMMIT>
        }
        flag "-y --yes" help="Install missing repository dependencies without asking"
        flag --prepare-image help="Clone the configured image and install dependencies there for this build"
        flag --dependency-artifact help="Reviewed local dependency artifacts to install into the disposable image" var=#true {
            arg <DEPENDENCY_ARTIFACT>
        }
        flag "-J --json" help="Print the files as JSON"
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <PACKAGE> help="The package name"
    }
    cmd diff help="Show the PKGBUILD diff since the approved commit" {
        flag --commit help="Diff to this commit instead of the current one" {
            arg <COMMIT>
        }
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <PACKAGE> help="The package name"
    }
    cmd review help="Review an AUR package at its current commit" {
        long_help #"""
Review an AUR package at its current commit

Fetches the package's git history and metadata, evaluates the policy findings against the last approved commit, and shows the PKGBUILD diff (or the whole PKGBUILD on a first review). Nothing is built.
"""#
        flag --commit help="Review this commit instead of the current one" {
            arg <COMMIT>
        }
        flag --no-diff help="Do not print the PKGBUILD diff"
        flag --unattended help="Evaluate as an unattended run would"
        flag "-J --json" help="Print as JSON"
        flag --pager help="Show the review and diff in a scrollable pager"
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <PACKAGE> help="The package name"
    }
    cmd receipt help="Inspect a local build receipt and verify the artifact still matches it" {
        flag --json
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <ARTIFACT>
    }
}
cmd build-env help="Provision Arch build images with devtools" subcommand_required=#true {
    flag "-h --help" help="Print help" action=help builtin=#true
    cmd init help="Create a new base-devel image; requires devtools and root privileges" {
        flag --package help="Additional repository packages" var=#true {
            arg <PACKAGE>
        }
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <ROOT>
    }
    cmd update help="Clone and update an image into a new destination, preserving the original" {
        flag --destination required=#true {
            arg <DESTINATION>
        }
        flag --package var=#true {
            arg <PACKAGE>
        }
        flag "-y --yes"
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <ROOT>
    }
}
cmd cache help="Inspect retained build data or prune unused runs" subcommand_required=#true {
    flag "-h --help" help="Print help" action=help builtin=#true
    cmd status help="Show retained build runs and protected evidence" {
        flag --json
        flag "-h --help" help="Print help" action=help builtin=#true
    }
    cmd prune help="Remove unused runs older than the retention window or over the size budget" {
        flag --dry-run help="Preview without deleting anything"
        flag --older-than-days help="Retain unused runs for this many days (recent runs always have a one-hour grace)" default="30" {
            arg <OLDER_THAN_DAYS>
        }
        flag --max-bytes help="Target total bytes; protected runs can keep usage above this target" {
            arg <MAX_BYTES>
        }
        flag --json
        flag "-h --help" help="Print help" action=help builtin=#true
    }
}
cmd channel help="Show the channel and snapshot this machine follows, or pin one" {
    long_help #"""
Show the channel and snapshot this machine follows, or pin one

The channel comes from the Omarchy repository's server URL. Its signed release manifest says which snapshot the channel points at, whether it passed the test suite, when it was promoted, and which packages were exercised. `pin` freezes the Arch mirror on a snapshot; `unpin` restores the mirrorlist that was in place before.
"""#
    flag --offline help="Use the cached feeds only" global=#true
    flag "-J --json" help="Print as JSON" global=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    cmd pin help="Pin the Arch mirror to a snapshot" {
        flag --force help="Pin even if the snapshot never reached rc or stable"
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <ID> help="The snapshot id, such as 2026-09-03T06"
    }
    cmd unpin help="Restore the mirrorlist from before the pin" {
        flag "-h --help" help="Print help" action=help builtin=#true
    }
}
cmd doctor help="Check that this machine is set up for pacvamp" {
    long_help #"""
Check that this machine is set up for pacvamp

Reports the pacman binary, the configuration and its repositories with their signature levels against the floor pacvamp expects, sync database freshness, the local database, and how pacvamp would obtain root. Also probes the running kernel's sandbox and reports configured policy, authenticated feed freshness, publisher evidence, and snapshot availability. Uses cached feeds unless --refresh is passed; never changes package or approval state.
"""#
    flag --refresh help="Fetch signed feeds to check current publisher availability"
    flag "-J --json" help="Print as JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd drop help="Remove packages from your manifest, then from the machine" {
    long_help #"""
Remove packages from your manifest, then from the machine

Deletes the entries from the user manifest. A package that no lower layer still declares present is then removed if installed; one the distro layer declares stays, since dropping it means "back to the default".
"""#
    flag "-y --yes" help="Proceed without asking; refuses a plan with warnings"
    flag "-n --dry-run" help="Update the manifest and show what would run, run nothing"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <PACKAGES>... help="Package names"
}
cmd info help="Show what is known about packages" {
    long_help #"""
Show what is known about packages

Looks each name up in the sync databases in repository order and in the local database, and shows the repository, trust tier, metadata, and installed state. A name no repository carries is looked up on the AUR, where the maintainer, votes, and ages are what matter.
"""#
    flag "-a --aur" help="Look on the AUR even when a repository carries the name"
    flag --no-aur help="Never consult the AUR"
    flag "-J --json" help="Print as JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <PACKAGES>... help="Package names"
}
cmd import help="Preview a manifest from explicitly installed packages" {
    long_help #"""
Preview a manifest from explicitly installed packages

Matches current repositories and queries AUR metadata for foreign packages. Existing declarations are preserved. Unknown foreign packages are skipped; an AUR match is a candidate source, not proof of the installed build's origin. No packages are installed and no approvals or provenance are created.
"""#
    flag --write help="Save the proposed additions to the user manifest without installing anything"
    flag --offline help="Do not query the AUR; foreign packages remain unresolved"
    flag "-J --json" help="Print the preview as JSON; incompatible with --write"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd install help="Install packages from the repositories" {
    long_help #"""
Install packages from the repositories

Each name is looked up in the sync databases in repository order, or pinned with `repo/name`. The plan shows every package the transaction would touch with its trust tier before anything happens. Nothing is recorded in the manifest; see `add` for that.
"""#
    flag "-a --aur" help="Install from the AUR: review, approve, build in the jail, install"
    flag "-y --yes" help="Proceed without asking; refuses a plan with warnings"
    flag "-n --dry-run" help="Show the plan and the command, run nothing"
    flag --reinstall help="Reinstall packages that are already installed"
    flag --as-deps help="Record the packages as dependencies rather than explicit installs"
    flag "-J --json" help="Print the plan as JSON and run nothing"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <PACKAGES>... help="Package names, optionally as repo/name"
}
cmd __jail help="Restrict this process per a JSON spec on stdin, then exec the command" hide=#true {
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd __build help="Apply build limits and optional filesystem confinement, then execute" hide=#true {
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd __ledger help="Merge a ledger patch from stdin; pacvamp runs this elevated" hide=#true {
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd __write help="Write a pacman configuration file per a JSON request on stdin; pacvamp runs this elevated" hide=#true {
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd list help="List installed packages with their trust tier" {
    flag "-e --explicit" help="Only packages installed explicitly"
    flag "-d --deps" help="Only packages installed as dependencies"
    flag "-f --foreign" help="Only packages no sync database carries (usually AUR builds)"
    flag "-n --native" help="Only packages a sync database carries"
    flag "-o --orphans" help="Only dependencies nothing installed needs any more"
    flag "-l --ledger" help="Only packages pacvamp installed, with what it recorded"
    flag --drift help="Only packages pacvamp installed whose state changed outside pacvamp"
    flag "-J --json" help="Print as JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd missing help="Exit 0 when none of the named packages is installed, else 1" {
    long_help #"""
Exit 0 when none of the named packages is installed, else 1

The complement of `present`, with the same matching rules.
"""#
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <PACKAGES>... help="Package names, optionally with a version constraint"
}
cmd pacnew help="List .pacnew and .pacsave files under /etc, and show their diffs" {
    long_help #"""
List .pacnew and .pacsave files under /etc, and show their diffs

pacman leaves a .pacnew beside a configuration file you changed when the package ships a new default, and a .pacsave when a package that owned a file is removed. Nothing is merged for you here.
"""#
    flag "-d --diff" help="Show a unified diff of each pair"
    flag "-J --json" help="Print as JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd plan help="Show what `apply` would change" {
    long_help #"""
Show what `apply` would change

Compares every declared package with the local database and lists the installs and removals, with the file each declaration came from.
"""#
    flag "-J --json" help="Print as JSON"
    flag --detailed-exitcode help="Exit 2 when there are changes, 0 when there are none"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd present help="Exit 0 when every named package is installed, else 1" {
    long_help #"""
Exit 0 when every named package is installed, else 1

A name is satisfied by an installed package of that name or by one that provides it, and may carry a version constraint such as `pacman>=7`. Prints nothing; for menu guards and scripts.
"""#
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <PACKAGES>... help="Package names, optionally with a version constraint"
}
cmd remove help="Remove installed packages" {
    long_help #"""
Remove installed packages

Dependencies nothing else needs are removed too, like `pacman -Rs`, unless `--keep-deps` is given. The plan shows everything that would go before anything happens.
"""#
    flag "-p --pick" help="Choose explicitly installed packages in a picker"
    flag "-y --yes" help="Proceed without asking; refuses a plan with warnings"
    flag "-n --dry-run" help="Show the plan and the command, run nothing"
    flag --keep-deps help="Leave dependencies installed"
    flag --cascade help="Also remove packages that depend on the targets"
    flag --nosave help="Do not keep .pacsave copies of configuration files"
    flag "-J --json" help="Print the plan as JSON and run nothing"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[PACKAGES]..." help="Package names; or none with --pick"
}
cmd recover help="Inspect interrupted transactions and recover recorded successful operations" {
    flag --write help="Restore completed transactions whose installed versions still match"
    flag --id help="Inspect or restore only this transaction" {
        arg <ID>
    }
    flag --json help="Print pending transaction details as JSON"
    flag --discard help="Discard one inspected journal entry without changing installed packages" {
        arg <DISCARD>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd rollback help="Move the machine to an archived snapshot" {
    long_help #"""
Move the machine to an archived snapshot

Pins the mirror to the snapshot, then runs a full sync that allows downgrades so every package matches what the snapshot carried. Pair it with the filesystem snapshot Omarchy takes before updates.
"""#
    flag --snapshot help="The snapshot id to move to" required=#true {
        arg <SNAPSHOT>
    }
    flag "-y --yes" help="Proceed without asking"
    flag "-n --dry-run" help="Show the plan and the command, run nothing"
    flag --force help="Roll back to a snapshot that never reached rc or stable"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd search help="Search the sync databases, or the AUR, by name and description" {
    long_help #"""
Search the sync databases, or the AUR, by name and description

Every term must match, case-insensitively, in the package name or description. Repository results are grouped in pacman.conf order with the trust tier of each repository. With --aur the AUR is searched instead, and each hit shows its votes, maintainer, and age.
"""#
    flag "-a --aur" help="Search the AUR instead of the repositories"
    flag "-i --installed" help="Only show packages that are installed"
    flag "-J --json" help="Print as JSON"
    flag "-p --pick" help="Choose hits in a picker and install them"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <TERMS>... help="Words to look for"
}
cmd status help="Show every declared package and whether the machine matches" {
    flag --missing help="Only declarations the machine does not match"
    flag "-J --json" help="Print as JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd tools help="The vetted tool channel: list and fetch vendor tools for mise" subcommand_required=#true {
    long_help #"""
The vetted tool channel: list and fetch vendor tools for mise

A tool channel is a signed index of vendor releases the channel operator vetted, mirrored with their evidence. These commands are what the mise tool-channel plugin calls; they verify the index, the vendor's packslip, the mirror's provenance, and the artifact digest.
"""#
    flag --base help="The channel store URL; default [channel] tools_base" global=#true {
        arg <BASE>
    }
    flag --pubkey help="A minisign public key file to verify the channel with, instead of the keys under /etc/pacvamp/keys" global=#true {
        arg <PUBKEY>
    }
    flag --offline help="Use the cached index only" global=#true
    flag "-J --json" help="Print as JSON" global=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    complete pubkey type=path
    cmd fetch help="Download and verify one artifact" {
        flag "-p --platform" help="The mise platform, such as linux-x64" required=#true {
            arg <PLATFORM>
        }
        flag "-d --dest" help="The directory to write the artifact into" required=#true {
            arg <DEST>
        }
        flag --force help="Fetch a held version anyway"
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <TOOL>
        arg <VERSION>
        complete dest type=dir
    }
    cmd index help="Show the verified index" {
        flag "-h --help" help="Print help" action=help builtin=#true
    }
    cmd list help="List vetted versions of a tool, oldest first" {
        flag "-c --channel" help="Only versions in this channel: edge, rc, or stable" {
            arg <CHANNEL>
        }
        flag --all help="Include held versions"
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <TOOL>
    }
}
cmd update help="Update the machine: repositories, then the AUR" {
    long_help #"""
Update the machine: repositories, then the AUR

Refreshes the sync databases, plans the repository upgrade with the manifest's holds and the per-tier release-age floors, reviews every AUR package that has a newer commit, shows one plan, and applies it. Unattended (-y), a finding that denies skips that AUR package and the rest continues. Ends with the orphan and pacnew reports.
"""#
    flag "-y --yes" help="Proceed without asking; findings deny rather than warn"
    flag "-n --dry-run" help="Plan everything, run nothing"
    flag --no-aur help="Skip the AUR"
    flag --aur-only help="Only the AUR"
    flag --no-refresh help="Do not refresh the sync databases first"
    flag --prune-orphans help="Remove dependencies nothing needs any more"
    flag "-J --json" help="Print the plan as JSON and run nothing"
    flag --wait help="Queue behind another running update instead of failing"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd verify help="Re-run the evidence chain for a package or a package file" {
    long_help #"""
Re-run the evidence chain for a package or a package file

For a repository package, checks the file in pacman's cache against the repository's signed index: digest, size, sidecars, and the evidence the repository claims. For a file path, matches it to the index by name. Refuses an index older than the last one seen.
"""#
    flag --offline help="Use the cached feeds only"
    flag "-J --json" help="Print as JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <TARGET> help="A package name, or a path to a .pkg.tar.* file"
}
cmd version help="Show the version" {
    alias v
    flag "-J --json" help="Print as JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
}
