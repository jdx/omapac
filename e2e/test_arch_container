#!/usr/bin/env bash
# pacvamp against a real pacman inside archlinux:base-devel. The binary is
# copied in with `docker cp`, so it works with a remote daemon too. Skips
# when docker or the image is unavailable, unless PACVAMP_E2E_CONTAINER=1
# insists.
set -euo pipefail
cd "$(dirname "$0")/.."
image="${PACVAMP_E2E_IMAGE:-archlinux:base-devel}"
insist="${PACVAMP_E2E_CONTAINER:-}"
skip() {
	if [ -n "$insist" ]; then
		echo "    $1" >&2
		exit 1
	fi
	echo "    skipped: $1"
	exit 0
}
command -v docker >/dev/null 2>&1 || skip "no docker"
timeout 20 docker info >/dev/null 2>&1 || skip "docker daemon unavailable"
docker image inspect "$image" >/dev/null 2>&1 || docker pull "$image" >/dev/null 2>&1 || skip "image $image unavailable"
[ -x target/debug/pacvamp ] || skip "target/debug/pacvamp not built"

name="pacvamp-e2e-$$"
cleanup() {
	local status=$?
	if [ "$status" -ne 0 ] && [ -n "${PACVAMP_E2E_KEEP_ON_FAILURE:-}" ]; then
		echo "retained failed fixture: $name" >&2
	else
		docker rm -f "$name" >/dev/null 2>&1 || true
	fi
}
trap cleanup EXIT
docker create --privileged --name "$name" "$image" sleep 1200 >/dev/null
docker cp target/debug/pacvamp "$name:/usr/local/bin/pacvamp"
docker start "$name" >/dev/null
run() { docker exec "$name" bash -c "$1"; }
# Capture, then match: grep -q closing a pipe early would turn into a
# SIGPIPE failure under pipefail.
expect() {
	local pattern="$1" out
	out=$(run "$2")
	grep -qE -- "$pattern" <<<"$out" || {
		echo "expected /$pattern/ in output of: $2" >&2
		echo "$out" >&2
		return 1
	}
}

# Bring the rolling image fully current before any real package installs.
run "pacman -Syu --noconfirm >/dev/null"

# Read-only commands against the real local and sync databases.
expect '^pacvamp ' "pacvamp version"
expect 'ok    pacman' "pacvamp doctor"
expect '"name": "pacman"' "pacvamp search --json pacman"
expect 'Repository       core \[arch\]' "pacvamp info pacman"
run "pacvamp present pacman"
if run "pacvamp present definitely-not-a-package"; then
	echo "present should fail for a missing package" >&2
	exit 1
fi
expect '^base-devel ' "pacvamp list --explicit"
run "pacvamp missing definitely-not-a-package"
if run "pacvamp missing pacman definitely-not-a-package"; then
	echo "missing should fail when any named package is installed" >&2
	exit 1
fi

# Planning against the real resolver: the exact pacman command is shown
# and nothing changes.
candidate=$(run "comm -23 <(pacman -Slq | sort -u) <(pacman -Qq | sort -u) | head -n1")
[ -n "$candidate" ] || skip "no uninstalled sync package available"
expect 'would run: /usr/bin/pacman -S --noconfirm --needed -- ' "pacvamp install -n '$candidate'"
expect 'would run:|nothing to upgrade|up to date' "pacvamp update -n --no-aur"
before=$(run "pacman -Q | wc -l")

# A real install and removal of a small package, as root inside the
# container, through the guard variable pacvamp sets.
expect 'installing tree' "pacvamp install -y tree"
run "pacman -Q tree" >/dev/null
run "pacvamp remove -y tree" >/dev/null
after=$(run "pacman -Q | wc -l")
[ "$before" = "$after" ]

# The manifest round trip: add with a dry run declares without
# converging, plan reports the gap, apply closes it.
run "pacvamp add -n tree"
run 'pacvamp plan --detailed-exitcode; test $? = 2'
expect 'tree' "pacvamp apply -y"
run "pacman -Q tree" >/dev/null
expect 'tree' "pacvamp status"
# drop removes the declaration and the package; apply alone would leave
# an undeclared package where it is.
run "pacvamp drop -y tree" >/dev/null
if run "pacman -Q tree" >/dev/null 2>&1; then
	echo "tree should be gone after drop" >&2
	exit 1
fi
run "pacvamp audit --offline" >/dev/null 2>&1 || true

# Exercise a real makepkg/fakeroot build, not only the shell fixtures used
# by the Rust suite. Use a non-root account and synthetic private data.
docker exec -i "$name" bash <<'JAIL'
set -euo pipefail
useradd -m pacvamp-builder
mkdir -p /home/pacvamp-builder/build/{home,tmp,pkgs,src,logs,worktree}
printf '%s\n' 'fake credential' >/home/pacvamp-builder/credentials
cat >/home/pacvamp-builder/build/worktree/PKGBUILD <<'RECIPE'
pkgname=pacvamp-jail-probe
pkgver=1
pkgrel=1
arch=('any')
if cat /home/pacvamp-builder/credentials; then exit 91; fi
if echo poison >/tmp/pacvamp-jail-shared; then exit 92; fi
build() {
  cat <(printf 'int main(void) { return 0; }\n') >probe.c
  cc -g probe.c -o probe
  ./probe
}
package() {
  install -Dm755 "$srcdir/probe" "$pkgdir/usr/bin/pacvamp-jail-probe"
  install -Dm644 /etc/os-release "$pkgdir/usr/share/pacvamp-jail-probe/os-release"
}
RECIPE
chown -R pacvamp-builder:pacvamp-builder /home/pacvamp-builder
runuser -u pacvamp-builder -- env HOME=/home/pacvamp-builder/build/home \
  TMPDIR=/home/pacvamp-builder/build/tmp PKGDEST=/home/pacvamp-builder/build/pkgs \
  SRCDEST=/home/pacvamp-builder/build/src LOGDEST=/home/pacvamp-builder/build/logs \
  BUILDDIR=/home/pacvamp-builder/build /usr/local/bin/pacvamp __jail <<'SPEC'
{"writable":["/home/pacvamp-builder/build"],"readable":[],"network":false,"program":"/usr/bin/makepkg","args":["--noconfirm","--force","--holdver"],"cwd":"/home/pacvamp-builder/build/worktree"}
SPEC
test -f /home/pacvamp-builder/build/pkgs/pacvamp-jail-probe-1-1-any.pkg.tar.zst
bsdtar -xOf /home/pacvamp-builder/build/pkgs/pacvamp-jail-probe-1-1-any.pkg.tar.zst .BUILDINFO | grep '^installed = pacman-' >/dev/null
test ! -e /tmp/pacvamp-jail-shared
JAIL

# Also traverse the production aur approve/build path. A broad hand-written
# __jail spec cannot catch missing grants in spawn_makepkg's verification phase.
docker exec -i "$name" bash <<'PRODUCTION'
set -euo pipefail
pacman -S --noconfirm --needed git python >/dev/null
mkdir -p /srv/pacvamp-aur/work
cp /home/pacvamp-builder/build/worktree/PKGBUILD /srv/pacvamp-aur/work/PKGBUILD
cat >>/srv/pacvamp-aur/work/PKGBUILD <<'RECIPE'
touch "$PKGDEST/write-probe"
if [[ $BUILDDIR == *.verify ]]; then
  echo planted >"$PKGDEST/verify-only"
else
  test ! -e "$PKGDEST/verify-only" || exit 93
fi
RECIPE
cat >/srv/pacvamp-aur/work/.SRCINFO <<'SRCINFO'
pkgbase = pacvamp-jail-probe
	pkgver = 1
	pkgrel = 1
	arch = any

pkgname = pacvamp-jail-probe
SRCINFO
git -C /srv/pacvamp-aur/work init --quiet
git -C /srv/pacvamp-aur/work add PKGBUILD .SRCINFO
git -C /srv/pacvamp-aur/work -c user.name=Fixture -c user.email=fixture@example.invalid commit --quiet -m fixture
git clone --quiet --bare /srv/pacvamp-aur/work /srv/pacvamp-aur/pacvamp-jail-probe.git
chown -R pacvamp-builder:pacvamp-builder /srv/pacvamp-aur
cat >/srv/pacvamp-aur/rpc.py <<'PYTHON'
from http.server import BaseHTTPRequestHandler, HTTPServer
import json

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        package = dict(Name="pacvamp-jail-probe", PackageBase="pacvamp-jail-probe",
                       Version="1-1", FirstSubmitted=1, LastModified=1,
                       Maintainer="fixture", Submitter="fixture", NumVotes=100)
        body = json.dumps(dict(type="multiinfo", results=[package])).encode()
        self.send_response(200)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

HTTPServer(("127.0.0.1", 18763), Handler).serve_forever()
PYTHON
python /srv/pacvamp-aur/rpc.py >/srv/pacvamp-aur/rpc.log 2>&1 &
rpc_pid=$!
trap 'kill "$rpc_pid"' EXIT
for attempt in {1..50}; do
  if curl -fsS http://127.0.0.1:18763 >/dev/null 2>&1; then break; fi
  sleep 0.1
done
runuser -u pacvamp-builder -- env \
  PACVAMP_AUR_RPC_BASE=http://127.0.0.1:18763 \
  PACVAMP_AUR_GIT_BASE=file:///srv/pacvamp-aur \
  /usr/local/bin/pacvamp aur approve --force pacvamp-jail-probe
runuser -u pacvamp-builder -- env \
  PACVAMP_AUR_RPC_BASE=http://127.0.0.1:18763 \
  PACVAMP_AUR_GIT_BASE=file:///srv/pacvamp-aur \
  /usr/local/bin/pacvamp aur build pacvamp-jail-probe
artifact=$(find /home/pacvamp-builder/.cache/pacvamp/aur/.pacvamp-build/runs -path "*/pkgs/pacvamp-jail-probe-1-1-any.pkg.tar.zst" -print -quit)
test -f "$artifact"
test ! -e "$(dirname "$artifact")/verify-only"
bsdtar -xOf "$artifact" .BUILDINFO | grep '^installed = pacman-' >/dev/null

# Provision a separate build image, then prove host-only tools stay unavailable.
pacman -S --noconfirm --needed bubblewrap devtools >/dev/null
# The outer Docker fixture has no systemd service manager. Keep nspawn in
# its existing unit while retaining its real namespace and chroot setup.
systemd-machine-id-setup
cat >/usr/local/bin/systemd-nspawn <<'NSPAWN'
#!/usr/bin/env bash
exec /usr/bin/systemd-nspawn --keep-unit "$@"
NSPAWN
chmod 755 /usr/local/bin/systemd-nspawn
mkdir -p /srv/pacvamp-image
/usr/local/bin/pacvamp build-env init /srv/pacvamp-image/root --package pacman
/usr/local/bin/pacvamp build-env update /srv/pacvamp-image/root --destination /srv/pacvamp-image/prepared --package cmake -y
test ! -x /srv/pacvamp-image/root/usr/bin/cmake
test -x /srv/pacvamp-image/prepared/usr/bin/cmake
printf '%s\n' 'pacvamp-builder ALL=(root) NOPASSWD: ALL' >/etc/sudoers.d/pacvamp-fixture
chmod 440 /etc/sudoers.d/pacvamp-fixture
# Resolve a synthetic source hostname through a local DNS server. The image
# deliberately has the systemd-resolved symlink that broke this path previously.
cat >/srv/pacvamp-aur/dns.py <<'DNS'
import socketserver, struct
class DNS(socketserver.BaseRequestHandler):
    def handle(self):
        data, sock = self.request
        end = 12
        while data[end]:
            end += data[end] + 1
        end += 1
        question = data[12:end + 4]
        is_a = data[end:end + 2] == b"\x00\x01"
        answer = b"\xc0\x0c" + struct.pack("!HHIH", 1, 1, 60, 4) + b"\x7f\x00\x00\x01" if is_a else b""
        sock.sendto(data[:2] + struct.pack("!HHHHH", 0x8180, 1, int(is_a), 0, 0) + question + answer, self.client_address)
socketserver.UDPServer(("127.0.0.1", 53), DNS).serve_forever()
DNS
python /srv/pacvamp-aur/dns.py &
dns_pid=$!
cp /etc/resolv.conf /tmp/pacvamp-resolv.conf
trap 'kill "$rpc_pid" "$dns_pid" 2>/dev/null || true; cat /tmp/pacvamp-resolv.conf >/etc/resolv.conf' EXIT
printf 'nameserver 127.0.0.1\n' >/etc/resolv.conf
ln -sf /run/systemd/resolve/stub-resolv.conf /srv/pacvamp-image/root/etc/resolv.conf
mkdir -p /home/pacvamp-builder/.config/pacvamp
cat >/home/pacvamp-builder/.config/pacvamp/pacvamp.toml <<'CONFIG'
[policy.aur]
chroot = true
chroot_root = "/srv/pacvamp-image/root"
CONFIG
chown -R pacvamp-builder:pacvamp-builder /home/pacvamp-builder/.config
# A host-only marker under /usr must not be visible inside the image.
echo host-only >/usr/share/pacvamp-host-only
mkdir -p /srv/pacvamp-image/root/opt/pacvamp-image-tool
echo image-only >/srv/pacvamp-image/root/opt/pacvamp-image-tool/marker
cat >>/srv/pacvamp-aur/work/PKGBUILD <<'RECIPE'
test -f /opt/pacvamp-image-tool/marker || exit 96
if [[ $BUILDDIR == *.verify ]]; then
  curl --noproxy '*' -fsS http://pacvamp-source.test:18763/ >/dev/null || exit 97
fi
if test -e /usr/share/pacvamp-host-only; then exit 94; fi
if touch /usr/share/pacvamp-image-poison; then exit 95; fi
RECIPE
runuser -u pacvamp-builder -- git -C /srv/pacvamp-aur/work add PKGBUILD
runuser -u pacvamp-builder -- git -C /srv/pacvamp-aur/work -c user.name=Fixture -c user.email=fixture@example.com commit -qm 'chroot isolation probes'
runuser -u pacvamp-builder -- git -C /srv/pacvamp-aur/work push -q /srv/pacvamp-aur/pacvamp-jail-probe.git HEAD:master
runuser -u pacvamp-builder -- env   PACVAMP_AUR_RPC_BASE=http://127.0.0.1:18763   PACVAMP_AUR_GIT_BASE=file:///srv/pacvamp-aur   /usr/local/bin/pacvamp aur approve --force pacvamp-jail-probe
runuser -u pacvamp-builder -- env   PACVAMP_AUR_RPC_BASE=http://127.0.0.1:18763   PACVAMP_AUR_GIT_BASE=file:///srv/pacvamp-aur   /usr/local/bin/pacvamp aur build pacvamp-jail-probe --prepare-image
test ! -e /srv/pacvamp-image/root/usr/share/pacvamp-image-poison
python - <<'CHECK'
import glob,json
receipts=[json.load(open(p)) for p in glob.glob("/home/pacvamp-builder/.cache/pacvamp/aur/.pacvamp-build/runs/*/receipt.json")]
import os
images=[r.get("chroot") for r in receipts if r.get("chroot")]
assert images and all("pacvamp-image-" in p and not os.path.exists(p) for p in images)
CHECK
PRODUCTION
