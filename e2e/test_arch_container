#!/usr/bin/env bash
# omapac against a real pacman inside archlinux:base-devel. The binary is
# copied in with `docker cp`, so it works with a remote daemon too. Skips
# when docker or the image is unavailable, unless OMAPAC_E2E_CONTAINER=1
# insists.
set -euo pipefail
cd "$(dirname "$0")/.."
image="${OMAPAC_E2E_IMAGE:-archlinux:base-devel}"
insist="${OMAPAC_E2E_CONTAINER:-}"
skip() {
	if [ -n "$insist" ]; then
		echo "    $1" >&2
		exit 1
	fi
	echo "    skipped: $1"
	exit 0
}
command -v docker >/dev/null 2>&1 || skip "no docker"
timeout 20 docker info >/dev/null 2>&1 || skip "docker daemon unavailable"
docker image inspect "$image" >/dev/null 2>&1 || docker pull "$image" >/dev/null 2>&1 || skip "image $image unavailable"
[ -x target/debug/omapac ] || skip "target/debug/omapac not built"

name="omapac-e2e-$$"
cleanup() { docker rm -f "$name" >/dev/null 2>&1 || true; }
trap cleanup EXIT
docker create --name "$name" "$image" sleep 600 >/dev/null
docker cp target/debug/omapac "$name:/usr/local/bin/omapac"
docker start "$name" >/dev/null
run() { docker exec "$name" bash -c "$1"; }

# Real databases: refresh through pacman itself.
run "pacman -Sy --noconfirm >/dev/null"

# Read-only commands against the real local and sync databases.
run "omapac version" | grep -q '^omapac '
run "omapac doctor" | grep -q 'ok    pacman'
run "omapac search --json pacman" | grep -q '"name": "pacman"'
run "omapac info pacman" | grep -q 'Repository       core \[arch\]'
run "omapac present pacman"
if run "omapac present definitely-not-a-package"; then
	echo "present should fail for a missing package" >&2
	exit 1
fi
run "omapac list --explicit" | grep -q '^base '
run "omapac missing definitely-not-a-package"
if run "omapac missing pacman definitely-not-a-package"; then
	echo "missing should fail when any named package is installed" >&2
	exit 1
fi

# Planning against the real resolver: the exact pacman command is shown
# and nothing changes.
run "omapac install -n glibc" | grep -q 'would run: /usr/sbin/pacman -S --noconfirm --needed -- glibc'
run "omapac update -n --no-aur" | grep -qE 'would run:|nothing to upgrade|up to date'
before=$(run "pacman -Q | wc -l")

# A real install and removal of a small package, as root inside the
# container, through the guard variable omapac sets.
run "omapac install -y tree" | grep -q 'installing tree'
run "pacman -Q tree" >/dev/null
run "omapac remove -y tree" >/dev/null
after=$(run "pacman -Q | wc -l")
[ "$before" = "$after" ]

# The manifest round trip.
run "omapac add tree && omapac plan --detailed-exitcode; test \$? = 2"
run "omapac apply -y" | grep -q 'tree'
run "pacman -Q tree" >/dev/null
run "omapac status" | grep -q 'tree'
run "omapac drop tree && omapac apply -y" >/dev/null
if run "pacman -Q tree" >/dev/null 2>&1; then
	echo "tree should be gone after drop + apply" >&2
	exit 1
fi
run "omapac audit --offline" >/dev/null 2>&1 || true
