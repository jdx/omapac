#!/usr/bin/env bash
# Every binary starts, reports its version, and renders help.
set -euo pipefail
for bin in pacvamp pacvamp-repo; do
	# Consume all output: grep -q can close early and panic a Rust writer
	# with BrokenPipe as command help grows.
	"$bin" version | grep "^$bin " >/dev/null
	"$bin" --help | grep "Usage" >/dev/null
	"$bin" __usage | grep "^name $bin" >/dev/null
done
