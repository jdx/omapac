#!/usr/bin/env bash
set -eEuo pipefail
trap 'rc=$?; echo "PACVAMP_VM_FAIL status=$rc line=$LINENO"; sync; systemctl poweroff --no-block; exit "$rc"' ERR
case "$(systemd-detect-virt --vm)" in qemu|kvm) ;; *) false ;; esac
mkdir -p /var/lib/pacvamp-vm
if test -f /var/lib/pacvamp-vm/phase1; then
  test "$(pacman -Q pacvamp-vm-probe)" = 'pacvamp-vm-probe 1-1'
  test "$(pacvamp-vm-probe)" = 1
  python - <<'CHECK'
import json
state=json.load(open('/var/lib/pacvamp/state.json'))
assert state['packages']['pacvamp-vm-probe']['version']=='1-1'
assert not state.get('pending')
assert state['snapshot']=='2026-09-01T06'
CHECK
  echo PACVAMP_VM_PASS
  sync
  systemctl poweroff --no-block
  exit 0
fi
ip link set lo up
python -m http.server 18767 --bind 127.0.0.1 --directory /srv/vm-repos &
for _ in {1..50}; do
  if curl -fsS http://127.0.0.1:18767/ >/dev/null; then break; fi
  sleep 0.1
done
pacman -Syy --noconfirm
/usr/local/bin/pacvamp-previous install -y pacvamp-vm-probe
test "$(pacvamp-vm-probe)" = 1
ln -sfn versions/2 /srv/vm-repos/current
pacvamp update -y --no-aur
test "$(pacvamp-vm-probe)" = 2
mkdir -p /etc/pacman.d/hooks
cat >/usr/local/bin/vm-interrupt <<'HOOK'
#!/bin/sh
touch /run/pacvamp-interrupt-ready
sleep 3
HOOK
chmod 755 /usr/local/bin/vm-interrupt
cat >/etc/pacman.d/hooks/99-vm-interrupt.hook <<'HOOK'
[Trigger]
Operation = Upgrade
Type = Package
Target = pacvamp-vm-probe
[Action]
Description = VM interruption probe
When = PostTransaction
Exec = /usr/local/bin/vm-interrupt
HOOK
ln -sfn versions/3 /srv/vm-repos/current
pacvamp update -y --no-aur &
supervisor=$!
for _ in {1..100}; do
  if test -f /run/pacvamp-interrupt-ready; then break; fi
  kill -0 "$supervisor"
  sleep 0.1
done
test -f /run/pacvamp-interrupt-ready
kill -KILL "$supervisor"
wait "$supervisor" || true
for _ in {1..100}; do
  if ! test -e /var/lib/pacman/db.lck; then break; fi
  sleep 0.1
done
test ! -e /var/lib/pacman/db.lck
rm /etc/pacman.d/hooks/99-vm-interrupt.hook
pacvamp recover --json >/var/lib/pacvamp-vm/recovery.json
python - <<'CHECK'
import json
reports=json.load(open('/var/lib/pacvamp-vm/recovery.json'))
assert reports
assert all(not r['journal']['completed'] and not r['restorable'] for r in reports.values())
CHECK
pacvamp recover --write
python - <<'CHECK'
import json
assert json.load(open('/var/lib/pacvamp/state.json'))['pending']
CHECK
pacvamp rollback --snapshot 2026-09-01T06 -y
test "$(pacvamp-vm-probe)" = 1
while read -r transaction; do pacvamp recover --discard "$transaction"; done < <(python -c 'import json; print(*json.load(open("/var/lib/pacvamp/state.json"))["pending"], sep="\n")')
touch /var/lib/pacvamp-vm/phase1
echo PACVAMP_VM_PHASE1_PASS
sync
systemctl poweroff --no-block
